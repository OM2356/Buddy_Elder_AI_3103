rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'omkarsathe3103@gmail.com'
      );
    }

    // List-safe admin check without get()/exists() inside allow list (Cost-Optimization Clause)
    function isBootstrappedAdminToken() {
      return isVerified() && request.auth.token.email == 'omkarsathe3103@gmail.com';
    }

    // Validation Blueprints (Anti-Update-Gap)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'preferredLanguage', 'textSize', 'theme', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'preferredLanguage', 'textSize', 'theme', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['senior', 'caregiver', 'admin']
        && data.preferredLanguage in ['en', 'hi', 'mr']
        && data.textSize in ['normal', 'large', 'xlarge']
        && data.theme in ['light', 'dark']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'city', 'bloodGroup', 'emergencyNotes', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('bloodGroup' in data) || (data.bloodGroup is string && data.bloodGroup.size() <= 16))
        && (!('emergencyNotes' in data) || (data.emergencyNotes is string && data.emergencyNotes.size() <= 500))
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data, convId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'language', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == convId
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.language in ['en', 'hi', 'mr']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, convId, msgId) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'conversationId', 'userId', 'role', 'content', 'capabilityUsed', 'createdAt'])
        && isValidId(data.id) && data.id == msgId
        && isValidId(data.conversationId) && data.conversationId == convId
        && isValidId(data.userId)
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 10000
        && (!('capabilityUsed' in data) || (data.capabilityUsed is string && data.capabilityUsed.size() <= 80))
        && data.createdAt is timestamp;
    }

    function isValidWellnessCheckin(data, checkinId) {
      return data.keys().hasAll(['id', 'userId', 'mood', 'energyLevel', 'sleepHours', 'waterGlasses', 'sharingLevel', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'mood', 'energyLevel', 'sleepHours', 'waterGlasses', 'notes', 'sharingLevel', 'createdAt'])
        && isValidId(data.id) && data.id == checkinId
        && isValidId(data.userId)
        && data.mood in ['great', 'good', 'okay', 'low', 'stressed']
        && data.energyLevel is int && data.energyLevel >= 1 && data.energyLevel <= 10
        && (data.sleepHours is int || data.sleepHours is float) && data.sleepHours >= 0 && data.sleepHours <= 24
        && data.waterGlasses is int && data.waterGlasses >= 0 && data.waterGlasses <= 30
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.sharingLevel in ['PRIVATE', 'LIMITED', 'AUTHORIZED']
        && data.createdAt is timestamp;
    }

    function isValidReminder(data, reminderId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'scheduleTime', 'recurring', 'completed', 'timezone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'category', 'scheduleTime', 'recurring', 'completed', 'timezone', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == reminderId
        && isValidId(data.userId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category in ['medication', 'water', 'exercise', 'appointment', 'learning', 'family', 'custom']
        && data.scheduleTime is string && data.scheduleTime.size() >= 1 && data.scheduleTime.size() <= 40
        && data.recurring in ['none', 'daily', 'weekly']
        && data.completed is bool
        && data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConsentRecord(data, consentId) {
      return data.keys().hasAll(['id', 'userId', 'granteeEmail', 'moduleName', 'sharingLevel', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'granteeEmail', 'moduleName', 'sharingLevel', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == consentId
        && isValidId(data.userId)
        && data.granteeEmail is string && data.granteeEmail.size() >= 3 && data.granteeEmail.size() <= 200
        && data.moduleName is string && data.moduleName.size() >= 1 && data.moduleName.size() <= 64
        && data.sharingLevel in ['PRIVATE', 'LIMITED', 'AUTHORIZED']
        && data.status in ['pending', 'approved', 'rejected', 'revoked']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScamReport(data, reportId) {
      return data.keys().hasAll(['id', 'userId', 'channel', 'riskLevel', 'riskScore', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'channel', 'riskLevel', 'riskScore', 'summary', 'createdAt'])
        && isValidId(data.id) && data.id == reportId
        && isValidId(data.userId)
        && data.channel in ['sms', 'whatsapp', 'email', 'url', 'payment', 'phone']
        && data.riskLevel in ['LOW', 'MEDIUM', 'HIGH']
        && data.riskScore is int && data.riskScore >= 0 && data.riskScore <= 100
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    // 1. Admins Registry (server/console managed only)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdminToken();
      allow write: if false;
    }

    // 2. User Profile (non-PII preferences)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdminToken());
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role in ['senior', 'caregiver']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'textSize', 'theme', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();

      // 3. Isolated PII Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isVerified() && (resource.data.uid == request.auth.uid || isBootstrappedAdminToken());
        allow create: if isValidId(userId) && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId)
          && isVerified()
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'city', 'bloodGroup', 'emergencyNotes', 'updatedAt']))
          );
        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      }
    }

    // 4. Conversations & Messages (Master Gate Pattern)
    match /conversations/{convId} {
      allow get: if isValidId(convId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isBootstrappedAdminToken());
      allow create: if isValidId(convId)
        && isVerified()
        && isValidConversation(incoming(), convId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(convId)
        && isVerified()
        && isValidConversation(incoming(), convId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'language', 'updatedAt']))
        );
      allow delete: if isValidId(convId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());

      match /messages/{msgId} {
        allow get: if isValidId(convId) && isValidId(msgId) && isVerified()
          && (get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid || isAdmin());
        allow list: if isValidId(convId) && isVerified()
          && (resource.data.userId == request.auth.uid || isBootstrappedAdminToken());
        allow create: if isValidId(convId) && isValidId(msgId)
          && isVerified()
          && isValidChatMessage(incoming(), convId, msgId)
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/conversations/$(convId))
          && get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(convId) && isValidId(msgId) && isVerified()
          && (get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid || isAdmin());
      }
    }

    // 5. Wellness Check-ins
    match /wellnessCheckins/{checkinId} {
      allow get: if isValidId(checkinId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isBootstrappedAdminToken());
      allow create: if isValidId(checkinId)
        && isVerified()
        && isValidWellnessCheckin(incoming(), checkinId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(checkinId)
        && isVerified()
        && isValidWellnessCheckin(incoming(), checkinId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['sharingLevel', 'notes']))
        );
      allow delete: if isValidId(checkinId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 6. Smart Reminders
    match /reminders/{reminderId} {
      allow get: if isValidId(reminderId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isBootstrappedAdminToken());
      allow create: if isValidId(reminderId)
        && isVerified()
        && isValidReminder(incoming(), reminderId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reminderId)
        && isVerified()
        && isValidReminder(incoming(), reminderId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'scheduleTime', 'recurring', 'completed', 'timezone', 'updatedAt']))
        );
      allow delete: if isValidId(reminderId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 7. Autonomy Engine Consent Records (Terminal State Locked)
    match /consentRecords/{consentId} {
      allow get: if isValidId(consentId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isBootstrappedAdminToken());
      allow create: if isValidId(consentId)
        && isVerified()
        && isValidConsentRecord(incoming(), consentId)
        && incoming().userId == request.auth.uid
        && incoming().status in ['pending', 'approved']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(consentId)
        && isVerified()
        && isValidConsentRecord(incoming(), consentId)
        && incoming().userId == existing().userId
        && incoming().granteeEmail == existing().granteeEmail
        && incoming().moduleName == existing().moduleName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && !(existing().status in ['rejected', 'revoked'])
            && incoming().diff(existing()).affectedKeys().hasOnly(['sharingLevel', 'status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(consentId) && isAdmin();
    }

    // 8. Scam Shield Reports
    match /scamReports/{reportId} {
      allow get: if isValidId(reportId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.userId == request.auth.uid || isBootstrappedAdminToken());
      allow create: if isValidId(reportId)
        && isVerified()
        && isValidScamReport(incoming(), reportId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(reportId) && isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
