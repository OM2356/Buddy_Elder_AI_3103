# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model ID (default: gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# JWT_SECRET: Independent secret for signing JWT session tokens (min 32 chars in production)
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_JWT_SECRET"

# BACKUP_ENCRYPTION_SECRET: Independent secret for AES-256-GCM backup encryption (never reuse JWT_SECRET)
BACKUP_ENCRYPTION_SECRET="REPLACE_WITH_STRONG_INDEPENDENT_BACKUP_SECRET"

# ALLOWED_ORIGINS: Comma-separated CORS allowlist
ALLOWED_ORIGINS="http://localhost:3000"

# APP_URL: Public URL where this applet is hosted
APP_URL="http://localhost:3000"

# PORT: HTTP server port (AI Studio preview expects 3000)
PORT="3000"

# DATABASE_PATH: Path to SQLite database file
DATABASE_PATH="./data/buddy_elder.db"

