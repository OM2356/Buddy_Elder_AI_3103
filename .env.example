# ==============================================================================
# SERVER-SIDE ENVIRONMENT VARIABLES (Keep strictly private on Vercel / backend)
# Never prefix these with VITE_
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model ID (default: gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"

# JWT_SECRET: Independent secret for signing JWT session tokens (>= 32 chars in production)
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_JWT_SECRET"

# BACKUP_ENCRYPTION_SECRET: Independent secret for AES-256-GCM backup encryption (never reuse JWT_SECRET)
BACKUP_ENCRYPTION_SECRET="REPLACE_WITH_STRONG_INDEPENDENT_BACKUP_SECRET"

# FIREBASE_PROJECT_ID: Authoritative Firebase project ID for verifying Firebase ID tokens
FIREBASE_PROJECT_ID="gen-lang-client-0339283160"

# ALLOWED_ORIGINS: Comma-separated CORS allowlist
ALLOWED_ORIGINS="http://localhost:3000,https://buddy-elder-ai-31.vercel.app"

# APP_URL: Public URL where this application is hosted
APP_URL="http://localhost:3000"

# PORT: HTTP server port (AI Studio / local dev expects 3000)
PORT="3000"

# DATABASE_PATH: SQLite database path (defaults to /tmp/buddy_elder.db on Vercel)
DATABASE_PATH="./data/buddy_elder.db"

# RESEND_API_KEY: Optional Resend API key for password reset & admin notification emails
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Verified sender address in Resend (e.g. "Buddy Elder AI <noreply@yourdomain.com>")
RESEND_FROM_EMAIL=""

# ADMIN_NOTIFICATION_EMAIL: Optional admin inbox for feedback/system alerts
ADMIN_NOTIFICATION_EMAIL="omkarsathe3103@gmail.com"

# ==============================================================================
# FRONTEND PUBLIC ENVIRONMENT VARIABLES (Safe to expose via VITE_* in Vercel)
# Values below must come from Firebase Console -> Project settings -> Buddy Elder AI Web
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0339283160"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID="373454483929"
VITE_FIREBASE_APP_ID="1:373454483929:web:a4e321c3623df3196e29c8"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-333382bc-1651-47e3-9760-3843b6d200a1"

# VITE_API_BASE_URL: Leave empty on same-origin Vercel (/api/*) or local dev; set only if hosting Express separately
VITE_API_BASE_URL=""
